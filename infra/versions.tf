terraform {
  required_version = ">= 1.9"

  # Values come from backend.hcl: terraform init -backend-config=backend.hcl
  backend "azurerm" {
    use_azuread_auth = true
  }

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}
